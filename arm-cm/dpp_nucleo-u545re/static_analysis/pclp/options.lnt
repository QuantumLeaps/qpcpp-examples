// general options
-unit_check          // perform only subset check (suppresses Global Wrapup)
-max_threads=1       // suppress message "no '-max_threads=N' option"
++efreeze(686)       // never suppress (see PC-Lint-Plus in Safety-Critical)
//-vf                  // print names of all source files (for debugging linting)

//----------------------------------------------------------------------------
// include directories
-i%QP_PCLP%          // QP PCLP configuration
-i%QP%/include       // QP public includes

//----------------------------------------------------------------------------
// QP/C options for QP Applications
qpcpp.lnt            // QP/C++ PCLP options

//----------------------------------------------------------------------------
// additional suppression rules for this application

-i%QP%/ports/arm-cm/qk/gnu  // QP port includes
-i..                 // application includes

//! MP2-R10.2.2(A): enum 'APP::AppSignals' is not a scoped enumeration
-esym(9419,
 APP::AppSignals)

//! MP2-R6.5.1(A): non-static function declared outside of a header
-esym(902,
 APP::Philo::Philo,
 APP::Table::Table)

//! MP2-R8.14.1(A): side effects on right hand of logical operator '&&'
// false-positive
-efile(9007,
 -table.cpp)

//! PCLP-1762: member function could be made const
-efile(1762,
 -table.cpp)

// PCLP-9155 line comment may contain commented-out code
// reported for QM-generated reference comments
-efile(9155,
 -*.cpp)

//! PCLP-752: local declarator not referenced
-esym(752,
 *::initial_s)

//! PCLP-754: local struct member not referenced
-esym(754,
 *::act,
 *::target)

//! PCLP-641: implicit conversion of enum 'APP::AppSignals' to integral type
-esym(641,
 APP::AppSignals)

//! PCLP-1736: redundant access specifier (public)
-efile(1736,
 -dpp.hpp,
 -philo.cpp,
 -table.cpp)

//! PCLP-3708: variable '*::inst' has static duration but no initialization
-esym(3708,
 *::inst)
